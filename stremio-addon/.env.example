# Copy to .env and fill in. Every setting is optional unless noted.

PORT=7000
# Public HTTPS address of the add-on (needed behind a tunnel or proxy).
BASE_URL=
LOG_LEVEL=info

# all-labeled: unverified streams are shown, labeled "Not verified yet".
# verified-only: only streams that passed a real playback check (npm run verify) are shown.
STREAM_POLICY=all-labeled
VERIFIED_MAX_AGE_HOURS=72
DATABASE_PATH=./data/addon.db
# Minutes between background stream probes (0 = off). Probes never mark a stream verified.
HEALTH_PROBE_INTERVAL_MIN=30
# Where checks from this machine run from, e.g. IL. Shown next to "verified".
VERIFIER_LOCATION=
# Enables POST /admin/checks and /admin/probe. At least 16 characters.
ADMIN_TOKEN=

# i24NEWS (Brightcove). Find these with `npm run discover` on the host.
I24_BRIGHTCOVE_ACCOUNT=5377161796001
I24_BRIGHTCOVE_PLAYER_ID=
I24_BRIGHTCOVE_POLICY_KEY=
# en:<videoId>,fr:<videoId>,ar:<videoId>,he:<videoId>
I24_LIVE_VIDEO_IDS=

# Knesset Channel. A direct manifest URL, a page that embeds the player, or both.
KNESSET_LIVE_URL=
KNESSET_LIVE_PAGE=

# docker compose --profile tunnel: token from Cloudflare Zero Trust > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
