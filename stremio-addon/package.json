{
  "name": "israeli-tv-stremio-addon",
  "version": "0.1.0",
  "description": "Stremio add-on for Israeli live TV and VOD with verified playback",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/entry/node.ts",
    "start": "node dist/src/entry/node.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsx scripts/verify-streams.ts",
    "discover": "tsx scripts/discover.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:build": "wrangler deploy --dry-run --outdir .wrangler/dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
