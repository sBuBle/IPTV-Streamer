<span id="gtm-code-holder" data-gtm-code="GTM-PZDDCPJ" class="d-none"></span>

<script>
    function loadAnalyticsScripts() {
        let gtmCodeHolder = document.getElementById('gtm-code-holder');

        if(gtmCodeHolder == null){
            return;
        }

        const gtmCode = gtmCodeHolder.dataset.gtmCode;
        var script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtm.js?id=${gtmCode}`;

        var firstScript = document.getElementsByTagName('script')[0];
        firstScript.parentNode.insertBefore(script, firstScript);

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            'gtm.start': new Date().getTime(),
            event: 'gtm.js'
        });

        var noscriptTag = document.createElement('noscript');
        var iframe = document.createElement('iframe');
        iframe.src = `https://www.googletagmanager.com/ns.html?id=${gtmCode}`;
        iframe.height = '0';
        iframe.width = '0';
        iframe.style.display = 'none';
        iframe.style.visibility = 'hidden';
        noscriptTag.appendChild(iframe);

        document.body.appendChild(noscriptTag);

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", pushDataLayer);
        }
        else {
          pushDataLayer();
        }
    }
</script>

    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="/lib/vanilla-cookieconsent/dist/cookieconsent.css" />
    <noscript><link rel="stylesheet" type="text/css" href="/lib/vanilla-cookieconsent/dist/cookieconsent.css" /></noscript>
    <script type="text/javascript" defer src="/lib/vanilla-cookieconsent/dist/cookieconsent.umd.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

        // one-time migration: remove the legacy cc_cookie left on the old (www) scope.
        (function () {
            var host = location.hostname;             // www.kan.org.il
            var root = host.replace(/^www\./, '');    // kan.org.il
            if (host !== root) {
                var expired = 'cc_cookie=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
                document.cookie = expired + '; domain=' + host; // kills the www.kan.org.il cookie
                document.cookie = expired;                       // kills any host-only variant
                // the canonical ".kan.org.il" cookie has a different domain attribute and is NOT removed
            }
        })();

        document.documentElement.classList.add('cc--darkmode');
        const CAT_NECESSARY = "necessary";
        const CAT_ANALYTICS = "analytics";
        const CAT_ADVERTISEMENT = "advertisement";
        const CAT_FUNCTIONALITY = "functionality";
        const CAT_SECURITY = "security";
        const cookieBannerConfig = {"EnableCookieBanners":true,"TermsAndConditionsLink":"https://www.kan.org.il/content-pages/terms/","PrivacyPolicy":"https://www.kan.org.il/content-pages/privacy/"};

        CookieConsent.run({
            revision: 1,
            guiOptions: {
                consentModal: {
                    layout: 'bar inline',
                    position: 'bottom',
                    equalWeightButtons: false,
                    flipButtons: true
                },
                preferencesModal: {
                    layout: 'box',
                    equalWeightButtons: true,
                    flipButtons: false
                }
            },
            cookie: {
                expiresAfterDays: 182,
                domain: location.hostname.replace(/^www\./, ''),
                sameSite: 'Lax'
            },
            onFirstConsent: function (cookie) {
                if (cookie.cookie.categories.indexOf('analytics') != -1) {
                    loadAnalyticsScripts();
                }
                if (cookie.cookie.categories.indexOf('necessary') != -1) {
                }
            },

            onConsent: function () {
                if (CookieConsent.acceptedCategory('analytics')) {
                    if(npawSettings){
                       npawSettings.trackAdditionalEvents = true;
                    }
                }
                else{
                    if(npawSettings){
                        npawSettings.trackAdditionalEvents = false;
                    }
                }
            },

            onChange: function ({ changedCategories, changedServices }) {
                if (changedCategories.includes('analytics')) {
                    if (CookieConsent.acceptedCategory('analytics')) {
                        loadAnalyticsScripts();
                        if(npawSettings){
                            npawSettings.trackAdditionalEvents = true;
                        }
                    } else {
                        if(npawSettings){
                            npawSettings.trackAdditionalEvents = false;
                        }
                    }

                    if (changedServices['analytics'].includes('Google Analytics')) {
                        if (CookieConsent.acceptedService('Google Analytics', 'analytics')) {
                        loadAnalyticsScripts();
                        } else {
                            // Google Analytics was just disabled
                        }
                    }
                }
            },

            categories: {
                [CAT_NECESSARY]: {
                    enabled: true,  // this category is enabled by default
                    readOnly: true  // this category cannot be disabled
                },
                [CAT_ANALYTICS]: {
                    autoClear: {
                        cookies: [
                            {
                                name: /^_ga/
                            },
                            {
                                name: '_gid'
                            },
                            {
                                name: '_gcl_au'
                            },
                            {
                                name: /^__cf/
                            },
                            {
                                name: /^_cb/
                            },
                            {
                                name: 'TRINITY_USER_DATA'
                            }
                        ]
                    },

                    services: {
                        ga: {
                            label: 'Google Analytics',
                            cookies: [
                                {
                                    name: /^(_ga|_gid|__utma|__utmc|__utma)/
                                }
                            ]
                        }
                    }
                },
                targeting: {}
            },

            language: {
                default: 'he',
                rtl: 'he',
                translations: {
                    en: async () => {
                        const res = await fetch('/config/cookieconsent/en.json');
                        var s = await res.json();

                        if (s.consentModal && s.consentModal.footer) {
                            s.consentModal.footer = s.consentModal.footer
                                .replace('{privacy}', cookieBannerConfig.PrivacyPolicy)
                                .replace('{terms}', cookieBannerConfig.TermsAndConditionsLink);
                        };

                        if (s.preferencesModal && Array.isArray(s.preferencesModal.sections)) {
                            s.preferencesModal.sections.forEach(section => {
                                if (section.description) {
                                    section.description = section.description.replace('{privacy}', cookieBannerConfig.PrivacyPolicy);
                                }
                            });
                        }

                        return s;
                    },
                    he: async () => {
                        const res = await fetch('/config/cookieconsent/he.json');
                        var s = await res.json();

                        if (s.consentModal && s.consentModal.footer) {
                            s.consentModal.footer = s.consentModal.footer
                                .replace('{privacy}', cookieBannerConfig.PrivacyPolicy)
                                .replace('{terms}', cookieBannerConfig.TermsAndConditionsLink);
                        };

                        if (s.preferencesModal && Array.isArray(s.preferencesModal.sections)) {
                            s.preferencesModal.sections.forEach(section => {
                                if (section.description) {
                                    section.description = section.description.replace('{privacy}', cookieBannerConfig.PrivacyPolicy);
                                }
                            });
                        }

                        return s;
                    }
                }
            }
        });
        });
    </script>
    <script>
        window.addEventListener("load", (event) => {
            if (CookieConsent && CookieConsent.acceptedCategory('analytics')) {
                loadAnalyticsScripts();
            };
        });
    </script>

    
